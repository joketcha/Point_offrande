{
  "name": "pilotage-revisions",
  "private": true,
  "version": "0.1.0",
  "description": "Pilotage des révisions annuelles : planification, PDR, achats, transit, réception, techniciens, travaux, redémarrage, stabilisation, REX",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
