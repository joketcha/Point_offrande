{
  "name": "reliability-master",
  "private": true,
  "version": "0.1.0",
  "description": "RELIABILITY MASTER — AFRICA TO WORLD : simulateur immersif de l'ingénieur fiabiliste",
  "type": "module",
  "scripts": {
    "dev": "vite",
